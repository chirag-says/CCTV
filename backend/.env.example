# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinelai
DB_USER=postgres
DB_PASSWORD=postgres
DB_ECHO=false

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Vision Pipeline Configuration (SCRFD + ArcFace + ByteTrack)
INSIGHTFACE_MODEL_NAME=buffalo_sc
INSIGHTFACE_DET_SIZE=640
INSIGHTFACE_DET_THRESH=0.60
FACE_MATCH_TOLERANCE=0.4
FACE_EMBEDDING_DIM=512
BYTETRACK_TRACK_THRESH=0.5
BYTETRACK_TRACK_BUFFER=30
BYTETRACK_MATCH_THRESH=0.8
FRAME_SKIP=3
DETECTION_SCALE=0.5
EXIT_THRESHOLD_SECONDS=15
ENTRY_THRESHOLD_SECONDS=3
UNKNOWN_SIMILARITY_THRESHOLD=0.50
# Unknown faces not seen for this many days are deleted for good, with their
# images. Enrolled faces are never removed. 0 = keep until reviewed.
UNKNOWN_FACE_RETENTION_DAYS=15

# Camera Configuration
DEFAULT_CAMERA_SOURCE=0
MAX_CAMERAS=10

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Storage
SNAPSHOT_DIR=./snapshots
MAX_SNAPSHOT_SIZE_KB=200

# Safety & Security Modules
ENABLE_ATTRIBUTE_RECOGNITION=false
ENABLE_CROWD_DETECTION=true
CROWD_PROXIMITY_PX=150
CROWD_MIN_PERSONS=3
CROWD_SUSTAIN_SECONDS=5.0
ENABLE_LOITERING_DETECTION=true
LOITER_MOVEMENT_THRESHOLD_PX=50
LOITER_TIME_WINDOW_SEC=300
LOITER_ALERT_COOLDOWN_SEC=600
ENABLE_HAZARD_DETECTION=true
HAZARD_BACKEND=yolo
WEAPON_MODEL_PATH=yolo11m.pt
HAZARD_MODEL_PATH=yolov8n.pt
HAZARD_FRAME_INTERVAL=30
HAZARD_ALERT_COOLDOWN_SEC=30

# Pipeline Mode: "face" (default), "traffic", or "hybrid"
PIPELINE_MODE=face

# Traffic Mode: ANPR (License Plate Recognition)
ENABLE_ANPR=false
ANPR_MODEL_PATH=./models/license-plate-finetune-v1l.pt
ANPR_FRAME_INTERVAL=5
ANPR_PLATE_COOLDOWN_SEC=60
ANPR_OCR_LANGUAGES=en

# Traffic Mode: Vehicle-Person Safety Monitor
ENABLE_TRAFFIC_MONITOR=false
TRAFFIC_MODEL_PATH=yolov8n.pt
TRAFFIC_FRAME_INTERVAL=5
TRAFFIC_PROXIMITY_PX=50
TRAFFIC_ALERT_COOLDOWN_SEC=15

# Roboflow detection API — OPTIONAL and OFF. Local YOLO / RF-DETR is the
# vehicle and person detector; the cloud round trip cost ~750 ms per frame,
# a metered bill, and a copy of every frame leaving the site.
ROBOFLOW_API_KEY=your-roboflow-api-key-here
ROBOFLOW_MODEL_ID=indian-vehicles-dataset/2
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_CONFIDENCE_THRESHOLD=0.50
ENABLE_ROBOFLOW_DETECTION=false
ROBOFLOW_PERSON_MODEL_ID=people-detection-o4rdr/10
ROBOFLOW_PERSON_CONFIDENCE=0.50
ENABLE_ROBOFLOW_PERSON=false

# Person Re-Identification (cross-camera tracking)
ENABLE_REID=true
REID_MATCH_THRESHOLD=0.56
REID_GALLERY_MAX_SIZE=500
REID_SIGHTING_COOLDOWN=5.0
REID_FRAME_INTERVAL=10
REID_MODEL=osnet_x1_0_msmt17

# Phase 4 Global Person Identity — reversible and shadow-first
GLOBAL_ID_MODE=shadow
GLOBAL_ID_MISSING_TTL_SEC=120
GLOBAL_ID_FACE_GALLERY_SIZE=8
GLOBAL_ID_BODY_GALLERY_SIZE=8
GLOBAL_ID_BODY_MATCH_THRESHOLD=0.56
GLOBAL_ID_BODY_VOTES_REQUIRED=3
GLOBAL_ID_BODY_VOTE_WINDOW_SEC=8.0
GLOBAL_ID_BODY_VOTE_MIN_SPAN_SEC=1.0
# Keep similarity margins blank until calibrated on SentinelAI Phase 4 replay.
# GLOBAL_ID_BODY_MIN_MARGIN=
# GLOBAL_ID_FACE_MATCH_THRESHOLD=
# GLOBAL_ID_FACE_MIN_MARGIN=
# Only use measured directed travel times. Empty topology means no body-only cross-camera proposal.
GLOBAL_ID_CAMERA_TOPOLOGY=[]
GLOBAL_ID_PERSIST_EVENTS=true

# Cross-camera handoff: one "#N" per person across cameras (false = per-camera Track #N)
HANDOFF_ENABLED=true
HANDOFF_CLAIM_WINDOW_SEC=5.0
HANDOFF_MEMORY_SEC=60
# Learn which cameras overlap and which routes people walk, from ordinary
# traffic. No calibration or drawn areas needed. false freezes what is learned.
HANDOFF_LEARN_TOPOLOGY=true
HANDOFF_TOPOLOGY_PATH=data/handoff_topology.json
# Body appearance (OSNet re-ID, backend/models/osnet_x1_0_msmt17.pth) to tell
# apart people who walk a route together. false = position and timing only.
HANDOFF_APPEARANCE_ENABLED=true
HANDOFF_LOOK_MATCH=0.82
HANDOFF_LOOK_MARGIN=0.10

# Video Analysis
VIDEO_UPLOAD_DIR=./uploads/videos
MAX_VIDEO_SIZE_MB=2000
VIDEO_ANALYSIS_FRAME_SKIP=5
VIDEO_ANALYSIS_MAX_CONCURRENT=2

# Gallery Optimizer — Ollama Local VLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
IDENTITY_REVIEW_VLM_PROVIDER=ollama
ENABLE_IDENTITY_REVIEW=false

# Analysis rate by wall clock (Phase 1 item 6)
ANALYSIS_RATE_BY_CLOCK=true
ANALYSIS_FPS=25.0
ANALYSIS_FPS_GATE=5.0

# Product plan: basic | plus | pro (vehicles are pro + traffic/hybrid only)
PIPELINE_PLAN=plus
